                                                needReEmbed = true
                                            end
                                        end
                                    end
                                else
                                    needReEmbed = true
                                end
                                
                                -- 針對該玩家進行飛鏢獨立召喚
                                if needReEmbed and not isSpawning[pName] then
                                    isSpawning[pName] = os.clock()
                                    
                                    if trackedData and trackedData.AncestryConn then
                                        trackedData.AncestryConn:Disconnect()
                                    end
                                    targetTrackedShurikens[pName] = nil
                                    
                                    local spawnCFrame = myHRP.CFrame * CFrame.new(0, 0, -6)
                                    local spawnPos = spawnCFrame.Position

                                    if spawnRemote then
                                        pcall(function()
                                            spawnRemote:InvokeServer("NinjaShuriken", spawnCFrame, Vector3.new(0, -35.493, 0))
                                        end)
                                        RequestGrabOwnership()
                                    end

                                    task.spawn(function(tp, sp)
                                        for _ = 1, 15 do
                                            task.wait(0.06)
                                            if targetTrackedShurikens[pName] and targetTrackedShurikens[pName].Part and targetTrackedShurikens[pName].Part.Parent then 
                                                break 
                                            end
                                            ScanForShurikenNearPos(tp, sp, 35)
                                        end
                                        isSpawning[pName] = nil
                                    end, targetPlayer, spawnPos)
                                end
                            end
                        end
                    end
                    task.wait(0.4)
                end
            end)
        else
            if prot_connections["AntiKick"] then
                prot_connections["AntiKick"]:Disconnect()
                prot_connections["AntiKick"] = nil
            end
            for pName, trackedData in pairs(targetTrackedShurikens) do
                if trackedData then
                    if trackedData.AncestryConn then trackedData.AncestryConn:Disconnect() end
                    RemoveShuriken(trackedData.Model or trackedData.Part)
                end
            end
            targetTrackedShurikens = {}
            isSpawning = {}
        end
    end
})


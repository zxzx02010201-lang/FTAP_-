-- 癱軟備份儲存表
local ragdollConstraints = {}

local function applyRagdoll(enable)
    local char = localPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if enable then
        if hum then
            hum.RequiresNeck = false
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end
        
        -- 將所有肢體 Motor6D 替換為物理 Socket 約束 (保留軀幹連動)
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("Motor6D") and desc.Name ~= "Neck" and desc.Name ~= "RootJoint" then
                local socket = Instance.new("BallSocketConstraint")
                local a0 = Instance.new("Attachment")
                local a1 = Instance.new("Attachment")
                
                a0.CFrame = desc.C0
                a1.CFrame = desc.C1
                a0.Parent = desc.Part0
                a1.Parent = desc.Part1
                
                socket.Attachment0 = a0
                socket.Attachment1 = a1
                socket.LimitsEnabled = true
                socket.TwistLimitsEnabled = true
                socket.Parent = desc.Part0
                
                desc.Enabled = false
                
                table.insert(ragdollConstraints, {motor = desc, a0 = a0, a1 = a1, socket = socket})
            end
        end
        
        -- 開啟持續物理狀態維持
        ragdollConnection = RunService.Stepped:Connect(function()
            if not config.ragdollActive then
                if ragdollConnection then ragdollConnection:Disconnect() end
                return
            end
            if hum and hum:GetState() ~= Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
        end)
    else
        if ragdollConnection then
            ragdollConnection:Disconnect()
            ragdollConnection = nil
        end
        
        -- 還原所有 Motor6D
        for _, item in ipairs(ragdollConstraints) do
            if item.motor then item.motor.Enabled = true end
            if item.a0 then item.a0:Destroy() end
            if item.a1 then item.a1:Destroy() end
            if item.socket then item.socket:Destroy() end
        end
        ragdollConstraints = {}
        
        if hum then
            hum.RequiresNeck = true
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end


                local relativeMove = Vector3.zero
                
                -- 電腦鍵盤輸入
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    relativeMove = relativeMove + Vector3.new(0, 0, -1)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    relativeMove = relativeMove + Vector3.new(0, 0, 1)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    relativeMove = relativeMove + Vector3.new(-1, 0, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    relativeMove = relativeMove + Vector3.new(1, 0, 0)
                end
                
                -- 手機搖桿輸入轉換
                if hum.MoveDirection.Magnitude > 0 and relativeMove.Magnitude == 0 then
                    local lookDir = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
                    local rightDir = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
                    
                    local joystickMove = hum.MoveDirection
                    local forwardValue = joystickMove:Dot(lookDir)
                    local rightValue = joystickMove:Dot(rightDir)
                    
                    relativeMove = Vector3.new(rightValue, 0, -forwardValue)
                end
                
                -- 世界空間全 3D 方向計算
                if relativeMove.Magnitude > 0 then
                    local worldDirection = camCF:VectorToWorldSpace(relativeMove.Unit)
                    hrp.AssemblyLinearVelocity = worldDirection * config.glideSpeed
                else
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
                
                -- 根據斜飛模式決定姿態與 CFrame
                if config.glideMode == "一般斜飛" then
                    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + camCF.LookVector)
                elseif config.glideMode == "直立斜飛" then
                    local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
                    if flatLook.Magnitude > 0 then
                        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flatLook.Unit)
                    end
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hum:ChangeState(Enum.HumanoidStateType.None)
                end
            end)
        else
            if flyConnection then
                flyConnection:Disconnect()
                flyConnection = nil
            end
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
})


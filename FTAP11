local function RemoveShuriken(toyInstance)
    if not toyInstance or not toyInstance.Parent then return end
    pcall(function()
        RemoveGradientESP(toyInstance)
        local targetToy = toyInstance
        if typeof(toyInstance) == "Instance" and not toyInstance:IsA("Model") then
            local model = toyInstance:FindFirstAncestorOfClass("Model")
            if model and model ~= workspace then targetToy = model end
        end
        if destroyRemote and typeof(targetToy) == "Instance" and targetToy.Parent then
            destroyRemote:FireServer(targetToy)
        end
        if typeof(targetToy) == "Instance" and targetToy.Parent then
            targetToy:Destroy()
        end
    end)
end

local function IsShurikenPart(obj)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return false, nil end
    local lowerName = obj.Name:lower()
    if lowerName == "stickypart" or lowerName:find("shuriken") or lowerName:find("ninja") or lowerName:find("toy") or obj.Parent.Name:lower():find("shuriken") then
        local model = obj:FindFirstAncestorOfClass("Model") or obj
        if model and not aa1:GetPlayerFromCharacter(model) then
            return true, model
        end
    end
    return false, nil
end

local function EnablePhysics(targetObj)
    if not targetObj or not targetObj.Parent then return end
    pcall(function()
        local container = (targetObj:IsA("Model") and targetObj) or targetObj:FindFirstAncestorOfClass("Model") or targetObj
        if container then
            for _, p in ipairs(container:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.Anchored = false
                    p.CanCollide = false
                    p.CanTouch = true
                end
            end
        end
    end)
end

local function IsShurikenAlreadyTracked(partObj)
    for _, data in pairs(targetTrackedShurikens) do
        if data and data.Part == partObj then
            return true
        end
    end
    return false
end


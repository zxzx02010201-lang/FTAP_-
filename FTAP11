-- 僅改動中心身體的關節來維持直立狀態
local function makeCharacterUpright(character)
    if not character then return end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("Motor6D") and (part.Name == "RootJoint" or part.Name == "Neck" or part.Name == "Waist") then

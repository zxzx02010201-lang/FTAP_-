local function cust_CleanupPhysicsForTarget(index)
    local targetName = cust_targetNames[index]
    if targetName then
        local p = aa1:FindFirstChild(targetName)
        if p and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum then hum.PlatformStand = false end
            if hrp then
                local ap = hrp:FindFirstChild("Cust_ControlAP")
                if ap then ap:Destroy() end
                local ao = hrp:FindFirstChild("Cust_ControlAO")
                if ao then ao:Destroy() end
                local att = hrp:FindFirstChild("Cust_ControlAtt")
                if att then att:Destroy() end
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end

local function cust_CleanupPhysics()
    for i = 1, 2 do
        cust_CleanupPhysicsForTarget(i)
    end
end

local function cust_SpawnPallet()
    if cust_spawningPallet then return nil end
    cust_spawningPallet = true

    local pallet = aa40("PalletLightBrown")
    if not pallet then
        cust_spawningPallet = false
        return nil
    end

    local soundPart = aa31(pallet, "SoundPart", 3)
    if not soundPart then
        pallet:Destroy()
        cust_spawningPallet = false
        return nil
    end

    local retry = 0
    while retry < 10 do
        if not cust_enabled then
            pallet:Destroy()
            cust_spawningPallet = false
            return nil
        end
        aa35(soundPart)
        task.wait()
        if aa37(soundPart, "PartOwner") then break end
        retry = retry + 1
    end

    if not aa37(soundPart, "PartOwner") then
        pallet:Destroy()
        cust_spawningPallet = false
        return nil
    end

    for _, part in pairs(pallet:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Transparency = 0.8
        end
    end
    pallet.Name = "RagdollPalete_Cust"

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 900, 0)
    bv.Parent = soundPart

    cust_spawningPallet = false
    return pallet
end


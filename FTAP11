-- ======== 玩家狀態監測與黑洞防範模組 (全域深度監測版) ========
-- ====================================================================

-- 1. 專屬獨立變數
local monitor_enabled = false
local monitor_connections = {}
local monitor_kickedPlayers = {} -- 紀錄被 Kick 的 UserId -> 玩家名稱

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

-- 發送右下角系統 Notification 提示
local function monitor_Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 5
        })
    end)
end

-- 全局踢人 API（提供外部腳本呼叫）
_G.KickPlayer = function(player, reason)
    if player then
        monitor_kickedPlayers[player.UserId] = player.DisplayName or player.Name
        player:Kick(reason or "你已被踢出遊戲")
    end
end

-- 取得最新玩家清單 (名稱與 DisplayName)
local function getLatestPlayerList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(list, p.DisplayName .. " (@" .. p.Name .. ")")
    end
    return list
end

-- 尋找距離黑洞/威脅物件最近的玩家
local function getClosestPlayerToThreat(threatObject)
    local threatPosition = nil
    
    if threatObject:IsA("Model") and threatObject.PrimaryPart then
        threatPosition = threatObject.PrimaryPart.Position
    elseif threatObject:IsA("BasePart") then
        threatPosition = threatObject.Position
    else
        local part = threatObject:FindFirstChildWhichIsA("BasePart", true)
        if part then threatPosition = part.Position end
    end

    if not threatPosition then return nil end

    local closestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (player.Character.HumanoidRootPart.Position - threatPosition).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                closestPlayer = player
            end
        end
    end

    return closestPlayer
end

-- 檢查是否為黑洞/Blobman/Grabkick 踢出攻擊特徵
local function checkHyperBiteThreat(child)
    if not child then return end
    local nameLower = child.Name:lower()

    -- 涵蓋 BlackHole、Grabkick、Blobman、Mouth、Bite 等攻擊物件名稱
    if nameLower:find("blackhole") or nameLower:find("grabkick") or nameLower:find("blobman") or nameLower:find("mouth") or nameLower:find("bite") then
        task.spawn(function()
            -- 立即抓取離威脅物件最近的受害玩家
            local targetPlayer = getClosestPlayerToThreat(child)
            
            if targetPlayer then
                local targetName = targetPlayer.DisplayName or targetPlayer.Name
                
                -- 將該玩家登記為踢出狀態
                monitor_kickedPlayers[targetPlayer.UserId] = targetName
                
                -- 發送提示：【名稱，已被踢出】
                monitor_Notify("玩家踢出", targetName .. "，已被踢出", 5)
            end
        end)
    end
end

-- 2. 玩家加入監測
local function monitor_OnPlayerAdded(player)
    if not monitor_enabled then return end
    local name = player.DisplayName or player.Name
    monitor_Notify("玩家加入", name .. "，已加入遊戲", 4)
end

-- 3. 玩家離開監測
local function monitor_OnPlayerRemoving(player)
    if not monitor_enabled then return end
    local name = player.DisplayName or player.Name
    local userId = player.UserId

    -- 若已經被黑洞/Kick 名單標記過
    if monitor_kickedPlayers[userId] then
        monitor_kickedPlayers[userId] = nil -- 清除標記
    else
        -- 正常離線
        monitor_Notify("玩家離開", name .. "，已離開遊戲", 4)
    end
end

-- 4. 開啟/關閉監測邏輯
local function monitor_SetState(state)
    monitor_enabled = state
    
    if monitor_enabled then
        monitor_connections["PlayerAdded"] = Players.PlayerAdded:Connect(monitor_OnPlayerAdded)
        monitor_connections["PlayerRemoving"] = Players.PlayerRemoving:Connect(monitor_OnPlayerRemoving)
        
        -- 全域深度掃描 (防止黑洞藏在 Model 或 Character 裡面)
        for _, obj in ipairs(Workspace:GetDescendants()) do
            checkHyperBiteThreat(obj)
        end
        
        -- 全域監聽新發生的物件 (DescendantAdded)
        monitor_connections["DescendantAdded"] = Workspace.DescendantAdded:Connect(function(obj)
            if not monitor_enabled then return end
            checkHyperBiteThreat(obj)
        end)
        
        monitor_Notify("系統提示", "玩家進出與黑洞/Grabkick監測已開啟", 3)
    else
        for key, conn in pairs(monitor_connections) do
            if conn then
                conn:Disconnect()
            end
        end
        monitor_connections = {}
        monitor_kickedPlayers = {}
        
        monitor_Notify("系統提示", "玩家進出與黑洞監測已關閉", 3)
    end
end


local function ApplyGradientESP(target)
    if not target or not target.Parent then return nil end
    local parentModel = (target:IsA("Model") and target) or target:FindFirstAncestorOfClass("Model") or target
    if not parentModel then return nil end
    
    local existing = parentModel:FindFirstChild("ShurikenRainbowESP")
    if existing then return existing end

    local hl = Instance.new("Highlight")
    hl.Name = "ShurikenRainbowESP"
    hl.Adornee = parentModel
    hl.FillTransparency = 0.8
    hl.OutlineTransparency = 0.0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = parentModel

    table.insert(activeHighlights, hl)
    return hl
end

local function RemoveGradientESP(target)
    if not target or not target.Parent then return end
    local parentModel = (target:IsA("Model") and target) or target:FindFirstAncestorOfClass("Model") or target
    if not parentModel then return end
    local hl = parentModel:FindFirstChild("ShurikenRainbowESP")
    if hl then
        for i, h in ipairs(activeHighlights) do
            if h == hl then
                table.remove(activeHighlights, i)
                break
            end
        end
        hl:Destroy()
    end
end

aa3.RenderStepped:Connect(function()
    local hue = (os.clock() * 0.4) % 1
    local rainbowColor = Color3.fromHSV(hue, 0.9, 1.0)


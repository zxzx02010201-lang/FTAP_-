-- Rainbow 顏色計算輔助函數
local function getRainbowColor(offset)
    local hue = ((tick() * 0.4) + (offset or 0)) % 1
    return Color3.fromHSV(hue, 1, 1)
end

-- 2. ESP 繪製與清理輔助函數
local function esp_ClearPlayerESP(player)
    if esp_objects[player] then
        for _, obj in pairs(esp_objects[player]) do
            if typeof(obj) == "Instance" then
                obj:Destroy()
            elseif type(obj) == "table" and obj.Remove then
                obj:Remove()
            end
        end
        esp_objects[player] = nil
    end
end

local function esp_ClearAll()
    for player, _ in pairs(esp_objects) do
        esp_ClearPlayerESP(player)
    end
    esp_objects = {}
end

-- 建立/繪製指定玩家的 ESP
local function esp_CreatePlayerESP(player)
    esp_ClearPlayerESP(player)
    if player == aa4 or player == game.Players.LocalPlayer then return end -- 忽略自己

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp or not head then return end

    local cache = {}
    local offsetIndex = player.UserId or 1

    -- 模式 1：漸彩虹 (外框 BillboardGui + UIStroke)
    if esp_selectedStyle == "漸彩虹" then
        local bgui = Instance.new("BillboardGui")
        bgui.Name = "ESP_BoxBg_" .. player.Name
        bgui.Adornee = hrp
        bgui.Size = UDim2.new(4.5, 0, 6, 0)
        bgui.AlwaysOnTop = true
        bgui.LightInfluence = 0
        bgui.Parent = hrp

        local boxFrame = Instance.new("Frame")
        boxFrame.Size = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1
        boxFrame.Parent = bgui

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Color = getRainbowColor(offsetIndex * 0.1)
        stroke.Parent = boxFrame

        cache.BGui = bgui
        cache.Stroke = stroke

    -- 模式 2：漸變色全彩色 (全身 Highlight)
    elseif esp_selectedStyle == "漸變色全彩色" then
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight_" .. player.Name
        highlight.Adornee = char
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.35
        highlight.OutlineTransparency = 0
        highlight.FillColor = getRainbowColor(offsetIndex * 0.1)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.Parent = char

        cache.Highlight = highlight

    -- 模式 3：玩家彩色線條 (腳底延伸 3D Tracer Beam)
    elseif esp_selectedStyle == "玩家彩色線條" then
        local localPlayer = aa4 or game.Players.LocalPlayer
        local myChar = localPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end

        -- 我方腳底 Attachment
        local att0 = myHrp:FindFirstChild("ESP_SelfTracerAtt")
        if not att0 then
            att0 = Instance.new("Attachment")
            att0.Name = "ESP_SelfTracerAtt"
            att0.Position = Vector3.new(0, -2.8, 0) -- 腳底位置
            att0.Parent = myHrp
        end

        -- 目標玩家腳底 Attachment
        local att1 = Instance.new("Attachment")
        att1.Name = "ESP_TargetTracerAtt"
        att1.Position = Vector3.new(0, -2.8, 0)
        att1.Parent = hrp

        -- 建立光束線條 Beam
        local beam = Instance.new("Beam")
        beam.Name = "ESP_TracerBeam"
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Width0 = 0.2
        beam.Width1 = 0.2
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.Color = ColorSequence.new(getRainbowColor(offsetIndex * 0.1))
        beam.Parent = hrp

        cache.Att1 = att1
        cache.Beam = beam
    end

    esp_objects[player] = cache
end

-- 每幀更新動態彩虹色彩與繪製狀態
local function esp_UpdateAll()
    if not esp_enabled then
        esp_ClearAll()
        return
    end

    local playersList = aa1 and aa1:GetPlayers() or game.Players:GetPlayers()
    local localPlayer = aa4 or game.Players.LocalPlayer

    for _, player in ipairs(playersList) do
        if player ~= localPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- 若尚未建立 ESP 或已遺失 Instance，則重新建立
                if not esp_objects[player] then
                    esp_CreatePlayerESP(player)
                else
                    -- 動態更新彩虹色彩
                    local cache = esp_objects[player]
                    local offsetIndex = player.UserId or 1
                    local currentColor = getRainbowColor(offsetIndex * 0.05)

                    if cache.Stroke and cache.Stroke.Parent then
                        cache.Stroke.Color = currentColor
                    end
                    if cache.Highlight and cache.Highlight.Parent then
                        cache.Highlight.FillColor = currentColor
                    end
                    if cache.Beam and cache.Beam.Parent then
                        cache.Beam.Color = ColorSequence.new(currentColor)
                    end
                end
            else
                esp_ClearPlayerESP(player)
            end
        end
    end
end


-- 🎯 強制直立嵌入 (多對象支援)
-- =======================================================

local function InstantEmbedProcess(partObj, modelObj, targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then return false end
    local pName = targetPlayer.Name
    
    if targetTrackedShurikens[pName] and targetTrackedShurikens[pName].Part and targetTrackedShurikens[pName].Part.Parent then 
        return false 
    end
    if not partObj or not partObj.Parent or not partObj:IsA("BasePart") then return false end
    if IsShurikenAlreadyTracked(partObj) then return false end

    local targetChar = targetPlayer.Character
    if not targetChar or not targetChar.Parent then return false end
    
    local myTargetPart = targetChar:FindFirstChild("UpperTorso") 
        or targetChar:FindFirstChild("Torso") 
        or targetChar:FindFirstChild("HumanoidRootPart")
        
    if not myTargetPart or not myTargetPart.Parent then return false end

    EnablePhysics(modelObj or partObj)

    local verticalRotation = CFrame.Angles(math.rad(90), 0, 0)
    local targetStraightCFrame = myTargetPart.CFrame * verticalRotation

    pcall(function()
        if partObj and partObj.Parent then
            partObj.AssemblyLinearVelocity = Vector3.zero
            partObj.AssemblyAngularVelocity = Vector3.zero
            partObj.CFrame = targetStraightCFrame
        end
    end)

    if stickyRemote and partObj and partObj.Parent and myTargetPart and myTargetPart.Parent then
        pcall(function()
            stickyRemote:FireServer(partObj, myTargetPart, verticalRotation)
        end)
    end

    ApplyGradientESP(modelObj or partObj)

    local conn
    conn = partObj.AncestryChanged:Connect(function(_, parent)
        if not parent or not partObj:IsDescendantOf(workspace) then
            if conn then conn:Disconnect() end
            if targetTrackedShurikens[pName] and targetTrackedShurikens[pName].Part == partObj then
                targetTrackedShurikens[pName] = nil
            end
        end
    end)

    targetTrackedShurikens[pName] = {
        Part = partObj,
        Model = modelObj,
        TargetPart = myTargetPart,
        SpawnTime = os.clock(),
        ImmunityTime = os.clock() + 1.2,
        AncestryConn = conn
    }
    
    print("[防護模組] 飛鏢成功直立貼合目標！玩家: " .. pName)
    return true
end

local function ScanForShurikenNearPos(targetPlayer, spawnPos, maxDistance)
    if not targetPlayer or not targetPlayer.Character then return false end
    maxDistance = maxDistance or 35

    for _, descendant in ipairs(workspace:GetDescendants()) do
        local isShuriken, modelObj = IsShurikenPart(descendant)
        if isShuriken and not IsShurikenAlreadyTracked(descendant) then
            local partPos = descendant.Position
            if (partPos - spawnPos).Magnitude <= maxDistance then
                local success = InstantEmbedProcess(descendant, modelObj, targetPlayer)
                if success then return true end
            end
        end
    end
    return false
end


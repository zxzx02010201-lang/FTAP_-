    if palletObj:IsA("BasePart") then
        if not wood_originalState[palletObj] then
            wood_originalState[palletObj] = { Color = palletObj.Color, Material = palletObj.Material }
        end
        palletObj.Color = color
        palletObj.Material = material
    elseif palletObj:IsA("Model") then
        for _, part in ipairs(palletObj:GetDescendants()) do
            if part:IsA("BasePart") then
                if not wood_originalState[part] then
                    wood_originalState[part] = { Color = part.Color, Material = part.Material }
                end
                part.Color = color
                part.Material = material
            end
        end
    end
end

local function wood_RestorePallet(palletObj)
    -- 還原顏色與材質
    if palletObj:IsA("BasePart") and wood_originalState[palletObj] then
        palletObj.Color = wood_originalState[palletObj].Color
        palletObj.Material = wood_originalState[palletObj].Material
        wood_originalState[palletObj] = nil
    elseif palletObj:IsA("Model") then
        for _, part in ipairs(palletObj:GetDescendants()) do
            if part:IsA("BasePart") and wood_originalState[part] then
                part.Color = wood_originalState[part].Color
                part.Material = wood_originalState[part].Material
                wood_originalState[part] = nil
            end
        end
    end

    -- 清除特效物件與相關連線
    if wood_objects[palletObj] then
        for _, obj in pairs(wood_objects[palletObj]) do
            if typeof(obj) == "Instance" then
                obj:Destroy()
            elseif typeof(obj) == "RBXScriptConnection" then
                obj:Disconnect()
            end
        end
        wood_objects[palletObj] = nil
    end
end

local function wood_ClearAll()
    for palletObj, _ in pairs(wood_objects) do
        wood_RestorePallet(palletObj)
    end
    wood_objects = {}
    wood_originalState = {}
end

-- 檢查物件是否符合木板條件
local function wood_IsPallet(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        local nameLower = obj.Name:lower()
        if nameLower:find("pallet") or nameLower:find("palletlightbrown") or nameLower:find("木板") then
            return true
        end
    end
    return false
end

-- 尋找地圖/場景中的所有 Pallet 物件
local function wood_GetAllPallets()
    local foundPallets = {}
    
    for _, obj in ipairs(game.Workspace:GetDescendants()) do
        if wood_IsPallet(obj) then
            if not foundPallets[obj] and not (obj.Parent and foundPallets[obj.Parent]) then
                foundPallets[obj] = true
            end
        end
    end

    local palletList = {}
    for palletObj, _ in pairs(foundPallets) do
        table.insert(palletList, palletObj)
    end
    return palletList
end

-- 3. 高級特效生成邏輯
local function wood_CreateEffectForPallet(palletObj)
    wood_RestorePallet(palletObj)

    local targetPart = palletObj:IsA("BasePart") and palletObj or (palletObj.PrimaryPart or palletObj:FindFirstChildWhichIsA("BasePart"))
    if not targetPart then return end

    local cache = {}

    -- 定義參數與配置
    local colorTarget, trailSeq, particleSeq, lightColor, lightRange, lightBrightness
    local secondParticleSeq = nil -- 支援雙層粒子

    if wood_selectedEffect == "閃電" then
        colorTarget = Color3.fromRGB(0, 220, 255)
        trailSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 245, 255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 150, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 50, 180))
        })
        particleSeq = ColorSequence.new(Color3.fromRGB(150, 235, 255))
        lightColor = Color3.fromRGB(0, 180, 255)
        lightRange = 14
        lightBrightness = 3.5

    elseif wood_selectedEffect == "火焰" then
        colorTarget = Color3.fromRGB(255, 60, 0)
        trailSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 230, 100)),
            ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 100, 0)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 0, 0))
        })
        particleSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 200, 50)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 20, 0))
        })
        secondParticleSeq = ColorSequence.new(Color3.fromRGB(255, 255, 150))
        lightColor = Color3.fromRGB(255, 90, 0)
        lightRange = 16
        lightBrightness = 4.0

    elseif wood_selectedEffect == "星空" then
        colorTarget = Color3.fromRGB(130, 50, 255)
        trailSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(220, 160, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(60, 0, 120))
        })
        particleSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(180, 100, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 0, 180))
        })
        lightColor = Color3.fromRGB(160, 60, 255)
        lightRange = 12
        lightBrightness = 3.0

    elseif wood_selectedEffect == "聖光" then
        colorTarget = Color3.fromRGB(255, 215, 0)
        trailSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 200)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(218, 165, 32))
        })
        particleSeq = ColorSequence.new(Color3.fromRGB(255, 240, 150))
        lightColor = Color3.fromRGB(255, 220, 100)
        lightRange = 15
        lightBrightness = 3.8
    end

    -- 【1. 整體變色與高光材質】
    wood_ApplyColorAndMaterial(palletObj, colorTarget, Enum.Material.Neon)

    -- 【2. 建立動態 PointLight 光影】
    local centerAtt = Instance.new("Attachment")
    centerAtt.Name = "WoodEffect_Attachment"
    centerAtt.Parent = targetPart
    cache.CenterAtt = centerAtt

    local pointLight = Instance.new("PointLight")
    pointLight.Name = "WoodLight"
    pointLight.Color = lightColor
    pointLight.Range = lightRange
    pointLight.Brightness = lightBrightness
    pointLight.Shadows = false -- 關閉陰影可大幅提升效能
    pointLight.Parent = targetPart
    cache.Light = pointLight

    -- 【3. 建立 Trail 尾翼】
    local sizeX = targetPart.Size.X / 2
    local att0 = Instance.new("Attachment")
    att0.Name = "WoodTrail_Att0"
    att0.Position = Vector3.new(-sizeX, 0, 0)
    att0.Parent = targetPart
    cache.Att0 = att0

    local att1 = Instance.new("Attachment")
    att1.Name = "WoodTrail_Att1"
    att1.Position = Vector3.new(sizeX, 0, 0)
    att1.Parent = targetPart
    cache.Att1 = att1

    local trail = Instance.new("Trail")
    trail.Name = "WoodTrail"
    trail.Attachment0 = att0
    trail.Attachment1 = att1
    trail.Lifetime = 0.5
    trail.MinLength = 0.05
    trail.LightEmission = 0.95
    trail.LightInfluence = 0.1
    trail.Color = trailSeq
    trail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.1),
        NumberSequenceKeypoint.new(0.8, 0.6),
        NumberSequenceKeypoint.new(1, 1)
    })
    trail.Parent = targetPart
    cache.Trail = trail

    -- 【4. 主粒子發射器】
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "WoodMainParticles"
    emitter.Texture = "rbxassetid://1084991215"
    emitter.Rate = 15 -- 稍微降低粒子數量以保持順暢
    emitter.Speed = NumberRange.new(1.5, 5)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-100, 100)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.5),
        NumberSequenceKeypoint.new(0.7, 0.8),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Color = particleSeq
    emitter.Lifetime = NumberRange.new(0.4, 0.8)
    emitter.LightEmission = 0.9
    emitter.Parent = centerAtt
    cache.Emitter = emitter

    -- 【5. 副粒子發射器】
    if secondParticleSeq then
        local subEmitter = Instance.new("ParticleEmitter")
        subEmitter.Name = "WoodSubParticles"
        subEmitter.Texture = "rbxassetid://258122325"
        subEmitter.Rate = 10
        subEmitter.Speed = NumberRange.new(3, 7)
        subEmitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.4),
            NumberSequenceKeypoint.new(1, 0)
        })
        subEmitter.Color = secondParticleSeq
        subEmitter.Lifetime = NumberRange.new(0.5, 1.0)
        subEmitter.LightEmission = 1
        subEmitter.Parent = centerAtt
        cache.SubEmitter = subEmitter
    end

    -- 【6. 光影呼吸脈衝邏輯 (使用 Heartbeat 但僅針對單個物件更新，效能開銷極低)】
    local clock = math.random() * 10 -- 錯開每個木板的脈衝節奏
    local pulseConnection
    pulseConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not pointLight or not pointLight.Parent then
            pulseConnection:Disconnect()
            return
        end
        clock = clock + dt * 5
        local pulse = (math.sin(clock) + 1) / 2
        pointLight.Brightness = lightBrightness + (pulse * 1.5)
    end)
    cache.PulseConn = pulseConnection

    wood_objects[palletObj] = cache
end


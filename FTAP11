-- 取得物件中心位置 Position
local function tp_GetObjectPosition(obj)
    if obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        else
            local cf, _ = obj:GetBoundingBox()
            return cf.Position
        end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

-- 🏠 自動搜尋房屋（已修改：允許前面帶顏色的房屋，例如 RedHouse、BlueHouse 等）
local function tp_ScanHouses()
    tp_houseListMap = {}
    local options = {}
    local savedPositions = {}
    local seenDisplayNames = {} -- 防止重複名稱載入

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Folder") or obj:IsA("BasePart") then
            local rawName = obj.Name
            local nameLower = string.lower(rawName)

            -- 【匹配】: 只要結尾是 house 或 house + 數字（不論前面有無顏色字首，例如 redhouse, house1）
            if string.match(nameLower, ".*house%d*$") then
                local pos = tp_GetObjectPosition(obj)
                if pos then
                    -- 檢查距離是否太近
                    local isTooClose = false
                    for _, savedPos in ipairs(savedPositions) do
                        if (pos - savedPos).Magnitude < MIN_HOUSE_DISTANCE then
                            isTooClose = true
                            break
                        end
                    end

                    if not isTooClose then
                        -- 尋找房屋擁有者資訊
                        local ownerName = "無人占領"
                        local ownerVal = obj:FindFirstChild("Owner") or obj:FindFirstChild("Player") or obj:FindFirstChild("HouseOwner")
                        if ownerVal then
                            if ownerVal:IsA("StringValue") and ownerVal.Value ~= "" then
                                ownerName = ownerVal.Value
                            elseif ownerVal:IsA("ObjectValue") and ownerVal.Value then
                                ownerName = ownerVal.Value.Name
                            end
                        end

                        local displayName = rawName .. " (房主: " .. ownerName .. ")"

                        -- 【全域去重檢查】確保清單中絕對不出現重複項目
                        if not seenDisplayNames[displayName] then
                            seenDisplayNames[displayName] = true
                            table.insert(savedPositions, pos)
                            tp_houseListMap[displayName] = obj
                            table.insert(options, displayName)
                        end
                    end
                end
            end
        end
    end

    if #options == 0 then
        table.insert(options, "未搜尋到房屋")
    end

    return options
end


local function prot_GetPlayerList()
    local list = {}
    for _, p in ipairs(aa1:GetPlayers()) do
        if p ~= aa4 then
            local formattedName = p.DisplayName .. " (@" .. p.Name .. ")"
            if prot_selectedTargets[p.Name] then
                formattedName = "[✓] " .. formattedName
            end
            table.insert(list, formattedName)
        end
    end
    return list
end

local function prot_FindPlayerByFormat(formattedName)
    local cleanName = formattedName:gsub("^%[%✓%] ", "")
    for _, p in ipairs(aa1:GetPlayers()) do
        local nameStr = p.DisplayName .. " (@" .. p.Name .. ")"
        if nameStr == cleanName then return p end
    end
    return nil
end

local function prot_IsDataBelongToPlayer(targetPlayer, ...)
    if not targetPlayer or not targetPlayer.Character then return false end
    
    local char = targetPlayer.Character
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local args = {...}

    if typeof(args[1]) == "table" then
        local tbl = args[1]
        args = {}
        for _, val in pairs(tbl) do
            table.insert(args, val)
        end
    end

    for _, arg in ipairs(args) do
        if typeof(arg) == "Instance" then
            if arg:IsDescendantOf(char) or arg == char then return true end
        elseif typeof(arg) == "Vector3" and hrp then
            if (arg - hrp.Position).Magnitude <= 3 then return true end
        elseif typeof(arg) == "CFrame" and hrp then
            if (arg.Position - hrp.Position).Magnitude <= 3 then return true end
        elseif type(arg) == "string" then
            if char:FindFirstChild(arg) then return true end
        end
    end
    return false
end

local function prot_ClearTargetLines(victimPlayer)
    if not victimPlayer or not victimPlayer.Character then return end

    if aa5 and aa5:FindFirstChild("DestroyGrabLine") then
        local victimHRP = victimPlayer.Character:FindFirstChild("HumanoidRootPart")
        if victimHRP then
            aa5.DestroyGrabLine:FireServer(victimHRP)
        end
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj and obj.Parent and (obj:IsA("Beam") or obj:IsA("RopeConstraint") or obj:IsA("LineHandleAdornment")) then
            local att0 = obj:IsA("Beam") and obj.Attachment0 or (obj:IsA("RopeConstraint") and obj.Attachment0 or nil)
            local att1 = obj:IsA("Beam") and obj.Attachment1 or (obj:IsA("RopeConstraint") and obj.Attachment1 or nil)

            local inVictim = false
            if att0 and att0:IsDescendantOf(victimPlayer.Character) then inVictim = true end
            if att1 and att1:IsDescendantOf(victimPlayer.Character) then inVictim = true end
            if obj:IsDescendantOf(victimPlayer.Character) then inVictim = true end

            if inVictim then
                pcall(function() obj:Destroy() end)
            end
        end
    end
end

-- 支援多玩家連續反擊的執行函式
local function prot_ExecuteGrabCounter(victimPlayer)
    if not victimPlayer or not victimPlayer.Character then return end

    local myChar = aa4.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local victimHRP = victimPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not myHRP or not victimHRP then return end

    prot_isCountering = true

    local originalCFrame = myHRP.CFrame
    local underTargetCFrame = victimHRP.CFrame * CFrame.new(0, -6, 0)
    myHRP.CFrame = underTargetCFrame
    task.wait(0.02)

    prot_ClearTargetLines(victimPlayer)

    if aa11 then
        aa11:FireServer(victimHRP, victimHRP.CFrame)
    end
    if aa25 then
        aa25(victimPlayer, myHRP)
    end

    task.wait(0.04)

    prot_ClearTargetLines(victimPlayer)

    myHRP.CFrame = originalCFrame
    task.wait(0.2)
    prot_isCountering = false
end

